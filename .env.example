DATABASE_URL=postgresql://user:password@host:5432/dbname
# Payload creates all of its tables inside this schema only (never touches `public`)
DATABASE_SCHEMA=htad
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (image uploads). Leave empty to store files in the local media/ folder.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email (contact form). Without RESEND_API_KEY messages are only saved in the admin.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: public URL of the R2 bucket (r2.dev or custom domain). When set, images are served
# from Cloudflare directly instead of through this app.
R2_PUBLIC_URL=
